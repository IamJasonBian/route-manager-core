# Copy to .env — never commit real secrets.

# --- Amadeus (functions) ---
# For local `make dev` / netlify dev, use test app keys; netlify.toml sets AMADEUS_HOSTNAME=test (sandbox API).
AMADEUS_API_KEY=
AMADEUS_API_SECRET=
AMADEUS_HOSTNAME=test

# Skip live Amadeus in netlify functions (fast local API smoke tests)
# USE_MOCK_DATA=true

# --- Postgres (functions + scripts) ---
DB_USER=routeuser
DB_PASSWORD=routepass
DB_NAME=routedb
DB_HOST=localhost
DB_PORT=5432

# --- Vite client (prefix VITE_ is exposed to the browser) ---
# Same-origin Netlify functions (default when using netlify dev)
# VITE_API_URL=/.netlify/functions

# Optional: plain `npm run dev` (Vite on :5173) cannot run functions. Set this to proxy
# /.netlify/functions to a local functions server, e.g. after `netlify functions:serve`.
# VITE_FUNCTIONS_PROXY=http://127.0.0.1:9999

# Pure in-memory mock in the browser — no HTTP to functions for prices
# VITE_API_MODE=mock

# Point the SPA at a remote mock or staging API (full URL including path to functions)
# VITE_API_MODE=remote
# VITE_REMOTE_API_BASE=https://your-mock-host.example.com/.netlify/functions

# Skip Postgres-backed getRoutes; instant seeded routes in the UI
# VITE_USE_MOCK_ROUTES=true

# Optional: tighter client timeout (ms)
# VITE_API_TIMEOUT_MS=12000

# --- Google Cloud + delta.com booking (scripts/gcloud, scripts/booking) ---
# GCP project that owns the Secret Manager secrets + ADC quota.
# GCP_PROJECT=allocation-agent-service
# Secret Manager secret names holding the delta.com login.
# DELTA_USERNAME_SECRET=delta-com-username
# DELTA_PASSWORD_SECRET=delta-com-password
# Where the cached (gitignored) Playwright session is stored.
# DELTA_STORAGE_STATE=.secrets/delta-storage-state.json
# Login-loop retry count.
# DELTA_LOGIN_ATTEMPTS=3
# Override delta.com selectors here if the site markup shifts, e.g.
# DELTA_SEL_USERNAME=#login-form-userName

# --- aa.com (American Airlines) booking (scripts/gcloud, scripts/booking) ---
# Secret Manager secret names holding the aa.com login (AAdvantage # or email).
# AA_USERNAME_SECRET=aa-com-username
# AA_PASSWORD_SECRET=aa-com-password
# Where the cached (gitignored) Playwright session is stored.
# AA_STORAGE_STATE=.secrets/aa-storage-state.json
# Login-loop retry count.
# AA_LOGIN_ATTEMPTS=3
# Override aa.com URLs/selectors here if the site markup shifts, e.g.
# AA_LOGIN_URL=https://www.aa.com/login
# AA_SEL_USERNAME=#loginId

# --- Persistent CDP terminal (scripts/booking/cdp-terminal.mjs) ---
# Long-lived Chromium with a remote-debugging port for `connectOverCDP`/chrome://inspect.
# Port the Chrome DevTools Protocol listens on.
# CDP_PORT=9222
# Bind address. 127.0.0.1 is safe (tunnel in via SSH). 0.0.0.0 exposes it on the
# network — only on a trusted/firewalled host; it auto-adds --remote-allow-origins.
# CDP_BIND=127.0.0.1
# Persistent profile dir (gitignored). Holds cookies/login so it survives restarts.
# CDP_USER_DATA_DIR=.secrets/cdp-profile
# Page to open on startup (default about:blank).
# CDP_START_URL=https://www.delta.com/
# HEADLESS=true on a VM; the --headed/--headless flags override per run.
